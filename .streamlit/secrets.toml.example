# Copy this to .streamlit/secrets.toml for local work (that file is git-ignored).
# On Streamlit Community Cloud, paste the same lines into App settings > Secrets.
# Without a key, the assistant uses its rules-based router.
GEMINI_API_KEY = "paste-your-key-here"
# Optional: which Gemini model chooses the tool (default: gemini-3.5-flash)
# GEMINI_MODEL = "gemini-3.5-flash"
